# backend 容器首次启动时会为以下空值生成独立的 32 字节随机密钥。
# 以下三项只选择 Compose 拉取的镜像。公开导出会写入同版本 backend 镜像，Release 精简部署包再固定为
# CI 推送的 digest；私有源码 Compose 使用本地 backend 镜像。替换镜像源时必须使用受信仓库和已核验版本。
VELIN_BACKEND_IMAGE=ghcr.io/ttyob/velin-music:0.1.27
VELIN_REDIS_IMAGE=redis:7.4-alpine
VELIN_OWNTONE_IMAGE=owntone/owntone:29.3@sha256:6a88589edc4dd9c438da62a18a25374d3e6e01457745f241a22baf88c43c9582
# 认证摘要密钥轮换会使既有登录标识摘要失效。
VELIN_AUTH_HASH_KEY=
# 可逆凭据密钥轮换后，用户需成功登录 Web 一次才能恢复第三方客户端认证。
VELIN_CREDENTIAL_KEY=
VELIN_METRICS_TOKEN=

# 默认两个 HTTP Worker；扩容时根据实际并发指标调整。
VELIN_WEB_WORKERS=2
# 默认两路转码；扩大时还须同步调整后台系统限制。
VELIN_RESOURCE_PLUGIN_TRANSCODE_WORKERS=2
VELIN_NOTIFICATION_CLEANUP_SECONDS=300
VELIN_NOTIFICATION_CLEANUP_BATCH=500
VELIN_NOTIFICATION_CLEANUP_MAX_BATCHES=8
VELIN_NOTIFICATION_CLEANUP_TIME_BUDGET_SECONDS=2

# 用户插件业务事件只存 Redis，默认关闭；显式开启后默认保留 24 小时。
VELIN_PLUGIN_EVENT_WORKER_ENABLED=false
VELIN_PLUGIN_EVENT_POLL_SECONDS=2
VELIN_PLUGIN_EVENT_TTL_SECONDS=86400
# 低频 Last.fm 系统歌单同步、系统歌单自动补全和后台上传默认关闭；按需显式开启。
VELIN_LASTFM_SYNC_WORKER_ENABLED=false

# Android 附近 DLNA 必须配置接收器可达的 HTTP(S) Origin；HTTP 只应用于可信局域网。
# VELIN_PUBLIC_URL=http://192.168.0.28:8787
