# backend 容器首次启动时会为以下空值生成独立的 32 字节随机密钥。
# 公开部署包必须把它改成 CI 推送的不可变 backend 镜像地址和版本；源码 Compose 会使用本地镜像。
VELIN_BACKEND_IMAGE=ghcr.io/your-org/velin-music:1.0.0
# 认证摘要密钥轮换会使既有登录标识摘要失效。
VELIN_AUTH_HASH_KEY=
# 可逆凭据密钥轮换后，用户需成功登录 Web 一次才能恢复第三方客户端认证。
VELIN_CREDENTIAL_KEY=
VELIN_METRICS_TOKEN=

# 空闲转码 Worker 默认与系统的两路并发上限一致；扩大时还须同步调整后台系统限制。
VELIN_RESOURCE_PLUGIN_TRANSCODE_WORKERS=2
VELIN_NOTIFICATION_CLEANUP_SECONDS=300
VELIN_NOTIFICATION_CLEANUP_BATCH=500
VELIN_NOTIFICATION_CLEANUP_MAX_BATCHES=8
VELIN_NOTIFICATION_CLEANUP_TIME_BUDGET_SECONDS=2
VELIN_AUTOMATIC_BACKUP_ENABLED=true
VELIN_AUTOMATIC_BACKUP_SECONDS=86400

# 用户插件业务事件只存 Redis，默认保留 24 小时；允许范围为 300-604800 秒。
VELIN_PLUGIN_EVENT_WORKER_ENABLED=true
VELIN_PLUGIN_EVENT_POLL_SECONDS=2
VELIN_PLUGIN_EVENT_TTL_SECONDS=86400

# Android 附近 DLNA 必须配置接收器可达的 HTTP(S) Origin；HTTP 只应用于可信局域网。
# VELIN_PUBLIC_URL=http://192.168.0.28:8787
