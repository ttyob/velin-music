name: velin-music

services:
  backend:
    image: "@IMAGE@"
    container_name: velin-music
    restart: unless-stopped
    init: true
    # 容器内 root 只用于读取管理员明确挂载的不同 UID 媒体；不授予 privileged、宿主 PID 或 Docker Socket。
    user: "0:0"
    network_mode: host
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      # 数据目录默认位于 TRIM_PKGVAR，也允许安装向导选择现有目录；缺失源必须失败，避免静默新建空库。
      - type: bind
        source: "${wizard_data_dir:-${TRIM_PKGVAR:?}/docker-data}"
        target: /data
        bind:
          create_host_path: false
      # fnOS 向导选择的宿主音乐目录统一投影成 /storage，Web 初始化不能看到或提交宿主绝对路径。
      - type: bind
        source: "${wizard_storage_dir:?}"
        target: /storage
        bind:
          create_host_path: false
    tmpfs:
      - /tmp:size=256m,mode=1777
    stop_grace_period: 10s
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          test "$$(redis-cli -h 127.0.0.1 -p 27379 ping)" = PONG
          && test "$$(/app/bin/velin-media-gateway --version)" = 'velin-media-gateway protocol=1 static=1'
          && wget -qO- http://127.0.0.1:8787/api/v1/health >/dev/null
          && wget -qS -O /dev/null http://127.0.0.1:8787/index.html 2>&1 | grep -Fi 'X-Velin-Static-Delivery: go' >/dev/null
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
