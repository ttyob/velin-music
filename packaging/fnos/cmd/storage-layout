#!/bin/bash

# 解析并校验 fnOS 安装向导提供的两个 Docker bind source。
#
# 安装向导字段会直接参与 Compose 插值，因此路径必须是已存在的 fnOS 数据卷绝对目录，并拒绝会改变
# YAML 或 Compose 插值语义的字符。应用数据留空时才允许建立 fnOS 分配的默认目录；用户指定目录和音乐
# 目录都必须预先存在，避免拼写错误被静默创建成空库。两个真实路径不得相同或相互包含，否则数据库、
# Redis、缓存和媒体会突破既定的双根隔离。该检查可重复执行，只补齐 /data 内 Velin 自有子目录；失败
# 不删除、移动或覆盖任何已有文件，供 install_init、install_callback 与升级生命周期共同调用。
velin_prepare_storage_layout()
{
  : "${TRIM_PKGVAR:?fnOS 未提供应用数据目录}"

  VELIN_DATA_ROOT="${wizard_data_dir:-$TRIM_PKGVAR/docker-data}"
  VELIN_STORAGE_ROOT="${wizard_storage_dir:-}"

  velin_validate_wizard_path "应用数据目录" "$VELIN_DATA_ROOT"
  [ -n "$VELIN_STORAGE_ROOT" ] || velin_storage_fail "请选择音乐库目录。"
  velin_validate_wizard_path "音乐库目录" "$VELIN_STORAGE_ROOT"

  if [ -n "${wizard_data_dir:-}" ]; then
    [ -d "$VELIN_DATA_ROOT" ] || velin_storage_fail "指定的应用数据目录不存在：$VELIN_DATA_ROOT"
  else
    mkdir -p "$VELIN_DATA_ROOT" || velin_storage_fail "无法建立默认应用数据目录：$VELIN_DATA_ROOT"
  fi
  [ -d "$VELIN_STORAGE_ROOT" ] || velin_storage_fail "指定的音乐库目录不存在：$VELIN_STORAGE_ROOT"

  data_real="$(readlink -f -- "$VELIN_DATA_ROOT")" || velin_storage_fail "无法解析应用数据目录：$VELIN_DATA_ROOT"
  storage_real="$(readlink -f -- "$VELIN_STORAGE_ROOT")" || velin_storage_fail "无法解析音乐库目录：$VELIN_STORAGE_ROOT"
  velin_validate_resolved_volume_path "应用数据目录" "$data_real"
  velin_validate_resolved_volume_path "音乐库目录" "$storage_real"
  case "$data_real/" in
    "$storage_real/"*) velin_storage_fail "应用数据目录不能位于音乐库目录内。" ;;
  esac
  case "$storage_real/" in
    "$data_real/"*) velin_storage_fail "音乐库目录不能位于应用数据目录内。" ;;
  esac

  mkdir -p \
    "$VELIN_DATA_ROOT/config" \
    "$VELIN_DATA_ROOT/database" \
    "$VELIN_DATA_ROOT/runtime" \
    "$VELIN_DATA_ROOT/plugins" \
    "$VELIN_DATA_ROOT/cache" || velin_storage_fail "无法初始化应用数据目录：$VELIN_DATA_ROOT"

  velin_record_storage_layout "$data_real" "$storage_real"
  export VELIN_DATA_ROOT VELIN_STORAGE_ROOT
}

# 为可选卸载清理记录安装时已经复验的精确双根；状态只供生命周期脚本读取，不进入容器。
velin_record_storage_layout()
{
  data_real=$1
  storage_real=$2
  marker_file="$data_real/.velin-fnos-data-root"
  state_file="$TRIM_PKGVAR/.velin-fnos-storage-layout"
  expected_marker="velin-music-fnos-data-v1
$data_real"

  [ ! -L "$marker_file" ] || velin_storage_fail "应用数据标记不能是符号链接。"
  if [ -e "$marker_file" ]; then
    [ -f "$marker_file" ] || velin_storage_fail "应用数据标记不是普通文件。"
    [ "$(cat -- "$marker_file")" = "$expected_marker" ] \
      || velin_storage_fail "应用数据目录属于另一份安装或标记已损坏。"
  else
    marker_temp=$(mktemp "$data_real/.velin-fnos-data-root.tmp.XXXXXX") \
      || velin_storage_fail "无法建立应用数据标记。"
    (umask 077; printf '%s\n%s\n' 'velin-music-fnos-data-v1' "$data_real" > "$marker_temp") \
      || { rm -f -- "$marker_temp"; velin_storage_fail "无法写入应用数据标记。"; }
    chmod 600 -- "$marker_temp" \
      || { rm -f -- "$marker_temp"; velin_storage_fail "无法保护应用数据标记。"; }
    mv -f -- "$marker_temp" "$marker_file" \
      || { rm -f -- "$marker_temp"; velin_storage_fail "无法发布应用数据标记。"; }
  fi

  [ ! -L "$state_file" ] || velin_storage_fail "安装存储记录不能是符号链接。"
  if [ -e "$state_file" ] && [ ! -f "$state_file" ]; then
    velin_storage_fail "安装存储记录不是普通文件。"
  fi
  state_temp=$(mktemp "$TRIM_PKGVAR/.velin-fnos-storage-layout.tmp.XXXXXX") \
    || velin_storage_fail "无法建立安装存储记录。"
  (umask 077; printf 'data_root=%s\nstorage_root=%s\n' "$data_real" "$storage_real" > "$state_temp") \
    || { rm -f -- "$state_temp"; velin_storage_fail "无法写入安装存储记录。"; }
  chmod 600 -- "$state_temp" \
    || { rm -f -- "$state_temp"; velin_storage_fail "无法保护安装存储记录。"; }
  mv -f -- "$state_temp" "$state_file" \
    || { rm -f -- "$state_temp"; velin_storage_fail "无法发布安装存储记录。"; }
}

# `readlink -f` 后再次收紧到数据卷，防止 `/vol1/../../etc` 或指向系统目录的链接绕过字面前缀检查。
velin_validate_resolved_volume_path()
{
  path_label=$1
  resolved_path=$2
  case "$resolved_path" in
    /vol[0-9]/*) ;;
    *) velin_storage_fail "$path_label 的真实位置不在 fnOS 数据卷内。" ;;
  esac
}

# 向导目前只有文本字段，没有系统文件选择器；此白名单同时保护 shell、Compose 与 YAML 三层解析边界。
velin_validate_wizard_path()
{
  path_label=$1
  path_value=$2
  case "$path_value" in
    /vol[0-9]/*) ;;
    *) velin_storage_fail "$path_label 必须是 /vol数字/... 形式的绝对目录。" ;;
  esac
  case "$path_value" in
    *\"*|*\\*|*\$*|*:*|*$'\n'*|*$'\r'*)
      velin_storage_fail "$path_label 包含不受支持的路径字符。"
      ;;
  esac
}

# fnOS 1.1.8+ 会把 TRIM_TEMP_LOGFILE 展示给用户；stderr 同时保留 CLI 安装时的可诊断输出。
velin_storage_fail()
{
  message=$1
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$message" > "$TRIM_TEMP_LOGFILE"
  fi
  printf '%s\n' "$message" >&2
  exit 1
}
