#!/bin/bash

# 校验并执行 fnOS 卸载向导明确授权的应用数据清理。
#
# 清理只接受安装/升级阶段原子保存的规范双根，并要求数据根内标记同时匹配。音乐根只用于确认隔离边界，
# 永远不会成为删除目标。删除前先检查全部固定子目录均为真实目录而非链接；真正删除仅覆盖 config、
# database、runtime、plugins、cache、redis 和标记。该操作会永久删除 SQLite、密钥、插件及 Redis 数据，
# 不具备事务回滚能力；中途失败保留未处理项，管理员修复异常后可对同一安装重试。
velin_prepare_data_cleanup()
{
  case "${wizard_data_action:-keep}" in
    keep) return 1 ;;
    delete) ;;
    *) velin_uninstall_fail "卸载数据选项无效。" ;;
  esac

  : "${TRIM_PKGVAR:?fnOS 未提供应用数据目录}"
  state_file="$TRIM_PKGVAR/.velin-fnos-storage-layout"
  [ -f "$state_file" ] && [ ! -L "$state_file" ] \
    || velin_uninstall_fail "缺少可信的安装存储记录，已拒绝清理数据。"

  data_line=
  storage_line=
  extra_line=
  {
    IFS= read -r data_line || true
    IFS= read -r storage_line || true
    IFS= read -r extra_line || true
  } < "$state_file"
  case "$data_line" in data_root=*) cleanup_root=${data_line#data_root=} ;; *) cleanup_root= ;; esac
  case "$storage_line" in storage_root=*) storage_root=${storage_line#storage_root=} ;; *) storage_root= ;; esac
  [ -n "$cleanup_root" ] && [ -n "$storage_root" ] && [ -z "$extra_line" ] \
    || velin_uninstall_fail "安装存储记录格式无效，已拒绝清理数据。"

  velin_validate_cleanup_root "应用数据目录" "$cleanup_root"
  velin_validate_cleanup_root "音乐库目录" "$storage_root"
  [ "$cleanup_root" != "$storage_root" ] || velin_uninstall_fail "应用数据目录与音乐库目录不能相同。"
  case "$cleanup_root/" in "$storage_root/"*) velin_uninstall_fail "应用数据目录不能位于音乐库目录内。" ;; esac
  case "$storage_root/" in "$cleanup_root/"*) velin_uninstall_fail "音乐库目录不能位于应用数据目录内。" ;; esac

  marker_file="$cleanup_root/.velin-fnos-data-root"
  [ -f "$marker_file" ] && [ ! -L "$marker_file" ] \
    || velin_uninstall_fail "应用数据标记缺失或类型异常，已拒绝清理。"
  expected_marker="velin-music-fnos-data-v1
$cleanup_root"
  [ "$(cat -- "$marker_file")" = "$expected_marker" ] \
    || velin_uninstall_fail "应用数据标记与安装记录不匹配，已拒绝清理。"

  for managed_name in config database runtime plugins cache redis; do
    managed_path="$cleanup_root/$managed_name"
    [ ! -L "$managed_path" ] || velin_uninstall_fail "受管目录不能是符号链接：$managed_name"
    if [ -e "$managed_path" ] && [ ! -d "$managed_path" ]; then
      velin_uninstall_fail "受管路径不是目录：$managed_name"
    fi
  done
  export VELIN_CLEANUP_ROOT="$cleanup_root"
  export VELIN_CLEANUP_STATE="$state_file"
  return 0
}

# 只有上述完整预检成功后才进入不可回滚删除阶段；固定列表中不含 storage 或任何音乐目录。
velin_delete_managed_data()
{
  if ! velin_prepare_data_cleanup; then
    return 0
  fi
  for managed_name in config database runtime plugins cache redis; do
    managed_path="$VELIN_CLEANUP_ROOT/$managed_name"
    [ ! -e "$managed_path" ] || rm -rf -- "$managed_path" \
      || velin_uninstall_fail "无法清理应用数据目录：$managed_name"
  done
  rm -f -- "$VELIN_CLEANUP_ROOT/.velin-fnos-data-root" \
    || velin_uninstall_fail "无法清理应用数据标记。"
  rm -f -- "$VELIN_CLEANUP_STATE" \
    || velin_uninstall_fail "无法清理安装存储记录。"

  default_root=$(readlink -f -- "$TRIM_PKGVAR/docker-data" 2>/dev/null || true)
  if [ -n "$default_root" ] && [ "$VELIN_CLEANUP_ROOT" = "$default_root" ]; then
    rmdir -- "$VELIN_CLEANUP_ROOT" 2>/dev/null || true
  fi
}

# 存储记录必须已经是 `/volN` 下的真实目录，拒绝链接、卷根、点段和失效挂载。
velin_validate_cleanup_root()
{
  path_label=$1
  path_value=$2
  case "$path_value" in /vol[0-9]/*) ;; *) velin_uninstall_fail "$path_label 不在 fnOS 数据卷内。" ;; esac
  [ -d "$path_value" ] && [ ! -L "$path_value" ] \
    || velin_uninstall_fail "$path_label 不存在或类型异常。"
  resolved_path=$(readlink -f -- "$path_value") \
    || velin_uninstall_fail "无法解析$path_label。"
  [ "$resolved_path" = "$path_value" ] \
    || velin_uninstall_fail "$path_label 已不再指向安装时的真实目录。"
}

# fnOS 会展示 TRIM_TEMP_LOGFILE；stderr 同时保留 SSH 手动安装时的诊断信息。
velin_uninstall_fail()
{
  message=$1
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$message" > "$TRIM_TEMP_LOGFILE"
  fi
  printf '%s\n' "$message" >&2
  exit 1
}
